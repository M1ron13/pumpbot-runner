{
  "telegram": {
    "bot_token": "ВСТАВЬ_ТОКЕН_БОТА",
    "chat_id": "ВСТАВЬ_CHAT_ID_КАНАЛА",
    "api_base": "https://api.telegram.org",
    "parse_mode": "HTML",
    "disable_web_page_preview": true
  },
  "network": {
    "poll_interval_sec": 10,
    "request_timeout_sec": 15,
    "backoff_start_sec": 30,
    "backoff_max_sec": 900,
    "funding_refresh_sec": 60,
    "error_sleep_sec": 5,
    "min_sleep_sec": 1,
    "binance_tickers_url": "https://fapi.binance.com/fapi/v1/ticker/24hr",
    "binance_premium_index_url": "https://fapi.binance.com/fapi/v1/premiumIndex",
    "bybit_tickers_url": "https://api.bybit.com/v5/market/tickers?category=linear",
    "backoff_http_codes": [
      429,
      418,
      403
    ],
    "binance_klines_url": "https://fapi.binance.com/fapi/v1/klines?symbol={symbol}&interval=1m&limit={limit}",
    "bybit_klines_url": "https://api.bybit.com/v5/market/kline?category=linear&symbol={symbol}&interval=1&limit={limit}",
    "binance_klines_max": 1440,
    "bybit_klines_max": 1000,
    "binance_weight_header": "X-MBX-USED-WEIGHT-1M",
    "binance_klines_15m_url": "https://fapi.binance.com/fapi/v1/klines?symbol={symbol}&interval=15m&limit={limit}",
    "bybit_klines_15m_url": "https://api.bybit.com/v5/market/kline?category=linear&symbol={symbol}&interval=15&limit={limit}",
    "binance_oi_hist_url": "https://fapi.binance.com/futures/data/openInterestHist?symbol={symbol}&period={period}&limit={limit}",
    "bybit_oi_hist_url": "https://api.bybit.com/v5/market/open-interest?category=linear&symbol={symbol}&intervalTime={interval}&limit={limit}",
    "binance_price_url": "https://fapi.binance.com/fapi/v1/ticker/price?symbol={symbol}",
    "bybit_price_url": "https://api.bybit.com/v5/market/tickers?category=linear&symbol={symbol}",
    "llama_protocols_url": "https://defillama-datasets.llama.fi/emissionsProtocolsList",
    "llama_dataset_url": "https://defillama-datasets.llama.fi/emissions/{slug}",
    "binance_klines_range_url": "https://fapi.binance.com/fapi/v1/klines?symbol={symbol}&interval={interval}&startTime={start}&endTime={end}&limit=1500",
    "bybit_klines_range_url": "https://api.bybit.com/v5/market/kline?category=linear&symbol={symbol}&interval={interval}&start={start}&end={end}&limit=1000"
  },
  "universe": {
    "quote_suffix": "USDT",
    "min_24h_volume_usd": 10000000,
    "exclude_symbols": [
      "BTCUSDT",
      "ETHUSDT"
    ],
    "min_history_minutes": 120
  },
  "detection": {
    "window_main_sec": 900,
    "window_fast_sec": 300,
    "min_observations": 30,
    "sigma_floor_pct": 0.25,
    "zscore_threshold": 4.0,
    "min_abs_move_main_pct": 6.0,
    "volume_mult_main": 4.0,
    "fast_move_pct": 7.0,
    "volume_mult_fast": 5.0,
    "ticks_maxlen": 9000,
    "history_maxlen": 8640
  },
  "btc_filter": {
    "btc_symbol": "BTCUSDT",
    "btc_move_15m_pct": 2.0,
    "threshold_multiplier": 1.3
  },
  "alerts": {
    "cooldown_min": 60,
    "max_per_day": 40,
    "day_window_sec": 86400,
    "chart_url_template": "https://www.tradingview.com/chart/?symbol={exchange}%3A{symbol}.P",
    "volume_decimals": 1,
    "funding_decimals": 3,
    "price_significant_digits": 6,
    "shadow_kinds": [],
    "_комментарий_подтипы": "Подтипы алерта объявлены в context/publisher.py: PUMP_ALERT_SUBTYPES. Новый подтип добавляется туда и сначала сюда, в shadow_kinds."
  },
  "logging": {
    "file": "pump_bot.log",
    "format": "%(asctime)s %(levelname)s %(message)s",
    "level": "INFO"
  },
  "runtime": {
    "state_file": "state.json.gz",
    "state_save_sec": 900,
    "state_max_age_sec": 43200,
    "state_history_keep": 360,
    "max_runtime_sec": 0,
    "startup_ping": true,
    "watchdog_max_consecutive_failures": 30
  },
  "backfill": {
    "enabled": true,
    "lookback_minutes": 240,
    "batch_size": 20,
    "batch_pause_sec": 1.0,
    "binance_weight_limit": 1800,
    "gap_trigger_sec": 120,
    "gap_margin_minutes": 2,
    "ticks_window_sec": 1800
  },
  "open_interest": {
    "enabled": true,
    "binance_period": "15m",
    "bybit_interval": "15min",
    "points": 5,
    "threshold_pct": 3.0
  },
  "exhaustion": {
    "enabled": true,
    "lookback_candles": 8,
    "volume_decay": 0.6,
    "new_high_tolerance": 0.999,
    "watch_hours": 6,
    "min_wait_sec": 900
  },
  "event_context": {
    "enabled": true,
    "refresh_sec": 3600,
    "unlock_window_days": 7,
    "slug_overrides": {
      "arbitrum": "ARB",
      "celestia": "TIA",
