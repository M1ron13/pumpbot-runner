{
  "telegram": {
    "bot_token": "ВСТАВЬ_ТОКЕН_БОТА",
    "chat_id": "ВСТАВЬ_CHAT_ID_КАНАЛА",
    "api_base": "https://api.telegram.org",
    "parse_mode": "HTML",
    "disable_web_page_preview": true
  },
  "network": {
    "poll_interval_sec": 10,
    "request_timeout_sec": 15,
    "backoff_start_sec": 30,
    "backoff_max_sec": 900,
    "funding_refresh_sec": 60,
    "error_sleep_sec": 5,
    "min_sleep_sec": 1,
    "binance_tickers_url": "https://fapi.binance.com/fapi/v1/ticker/24hr",
    "binance_premium_index_url": "https://fapi.binance.com/fapi/v1/premiumIndex",
    "bybit_tickers_url": "https://api.bybit.com/v5/market/tickers?category=linear",
    "backoff_http_codes": [
      429,
      418
    ],
    "binance_klines_url": "https://fapi.binance.com/fapi/v1/klines?symbol={symbol}&interval=1m&limit={limit}",
    "bybit_klines_url": "https://api.bybit.com/v5/market/kline?category=linear&symbol={symbol}&interval=1&limit={limit}",
    "binance_klines_max": 1440,
    "bybit_klines_max": 1000,
    "binance_weight_header": "X-MBX-USED-WEIGHT-1M"
  },
  "universe": {
    "quote_suffix": "USDT",
    "min_24h_volume_usd": 10000000,
    "exclude_symbols": [
      "BTCUSDT",
      "ETHUSDT"
    ],
    "min_history_minutes": 120
  },
  "detection": {
    "window_main_sec": 900,
    "window_fast_sec": 300,
    "min_observations": 30,
    "sigma_floor_pct": 0.25,
    "zscore_threshold": 4.0,
    "min_abs_move_main_pct": 6.0,
    "volume_mult_main": 4.0,
    "fast_move_pct": 7.0,
    "volume_mult_fast": 5.0,
    "ticks_maxlen": 9000,
    "history_maxlen": 8640
  },
  "btc_filter": {
    "btc_symbol": "BTCUSDT",
    "btc_move_15m_pct": 2.0,
    "threshold_multiplier": 1.3
  },
  "alerts": {
    "cooldown_min": 60,
    "max_per_day": 40,
    "day_window_sec": 86400,
    "chart_url_template": "https://www.tradingview.com/chart/?symbol={exchange}%3A{symbol}.P",
    "volume_decimals": 1,
    "funding_decimals": 3,
    "price_significant_digits": 6
  },
  "logging": {
    "file": "pump_bot.log",
    "format": "%(asctime)s %(levelname)s %(message)s",
    "level": "INFO"
  },
  "runtime": {
    "state_file": "state.json.gz",
    "state_save_sec": 900,
    "state_max_age_sec": 43200,
    "state_history_keep": 360,
    "max_runtime_sec": 0,
    "startup_ping": true,
    "watchdog_max_consecutive_failures": 30
  },
  "backfill": {
    "enabled": true,
    "lookback_minutes": 240,
    "batch_size": 20,
    "batch_pause_sec": 1.0,
    "binance_weight_limit": 1800,
    "gap_trigger_sec": 120,
    "gap_margin_minutes": 2,
    "ticks_window_sec": 1800
  }
}