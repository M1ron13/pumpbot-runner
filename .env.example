# Ключи контекст-слоя. Скопировать в .env рядом (тот же каталог pumpbot) и вписать значения.
# .env в git не попадает. Переменные окружения, если заданы, приоритетнее этого файла.

# LLM-классификация новостей (Тип 4 и разбор свободного текста). Достаточно одного.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Поиск новостей «почему X растёт» (контур B)
TAVILY_API_KEY=

# Крипто-новости по тикеру + голоса bullish/bearish
CRYPTOPANIC_TOKEN=

# Календарь событий (контур A)
COINMARKETCAL_KEY=
